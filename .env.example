# ─── Database ───
POSTGRES_USER=steel_user
POSTGRES_PASSWORD=steel_pass_change_me
POSTGRES_DB=steel_defects
DATABASE_URL=postgresql://steel_user:steel_pass_change_me@db:5432/steel_defects

# ─── JWT ───
JWT_SECRET=replace-with-a-long-random-secret-key
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ─── Model ───
MODEL_PATH=../ai/checkpoints/best_model.pt

# ─── Backend ───
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
UPLOAD_DIR=./uploads

# ─── Storage (Supabase) ───
# Optional: Set SUPABASE_URL & SUPABASE_KEY to use Supabase Storage for defect images
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_KEY=your-supabase-anon-or-service-key
SUPABASE_STORAGE_BUCKET=steel-defects

# ─── Frontend ───
VITE_API_URL=http://localhost:8000/api
